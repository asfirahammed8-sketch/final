# ====================================================================================================
# DreamIT Platform - Environment Configuration Template
# ====================================================================================================
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env" (without .example)
# 2. Fill in your actual credentials (NEVER commit .env to Git!)
# 3. Keep .env.example in Git as a template (with no real passwords)
#
# SECURITY: The .env file is in .gitignore and will NOT be committed to Git
# ====================================================================================================

# ====================================================================================================
# DATABASE CONFIGURATION
# ====================================================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=dreamit
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ====================================================================================================
# EMAIL / SMTP CONFIGURATION
# ====================================================================================================

SMTP_HOST=mail.dreamitnaogaon.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=dreamitn@dreamitnaogaon.com
SMTP_PASSWORD=your_email_password_here

EMAIL_FROM_ADDRESS=dreamitn@dreamitnaogaon.com
EMAIL_FROM_NAME=Dream IT Naogaon Security
EMAIL_REPLY_TO=dreamitn@dreamitnaogaon.com

# ====================================================================================================
# TWO-FACTOR AUTHENTICATION (2FA)
# ====================================================================================================

# HMAC Secret Key for OTP Hashing (Generate a random 64-character string)
# Generate: https://www.random.org/strings/ (64 chars, alphanumeric)
TWO_FACTOR_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHAR_RANDOM_STRING_IN_PRODUCTION

# ====================================================================================================
# APPLICATION SETTINGS
# ====================================================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Application URL (used for canonical URLs, emails, etc.)
APP_URL=http://localhost/dreamit

# Debug Mode (true = show errors, false = hide errors)
APP_DEBUG=true

# Session Lifetime (in seconds, default 30 days = 2592000)
SESSION_LIFETIME=2592000

# ====================================================================================================
# SECURITY SETTINGS
# ====================================================================================================

# Session Timeout (inactivity timeout in seconds, default 30 minutes = 1800)
SESSION_IDLE_TIMEOUT=1800

# Rate Limiting (requests per minute for API)
RATE_LIMIT_PER_MINUTE=60

# ====================================================================================================
# ADMIN PANEL (DO NOT SET ADMIN CREDENTIALS HERE!)
# ====================================================================================================
#
# Admin credentials should ONLY be stored in the database with bcrypt hashing.
# Never store plain passwords in .env or any config files!
#
# To create/update admin accounts, use the database or admin panel interface.
#
# ====================================================================================================
